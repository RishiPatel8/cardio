# CardioGuard AI - Environment Configuration Specifications

# Core Application Settings
PROJECT_NAME="CardioGuard AI"
API_V1_STR="/api/v1"
SECRET_KEY="production-level-cryptographic-secret-key-32-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Coordinates
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="cardioguard"
POSTGRES_PORT=5432

# Redis Cache Coordinates
REDIS_HOST="localhost"
REDIS_PORT=6379

# Firebase Service Account Path
FIREBASE_CREDENTIALS_PATH="/path/to/firebase-credentials.json"
FIREBASE_PROJECT_ID="cardioguard-ai"
APP_CHECK_ENABLED=true

# Health Connect Integration Settings
HEALTH_CONNECT_CLIENT_ID="com.cardioguard.app"
